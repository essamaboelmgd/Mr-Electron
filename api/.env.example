NODE_ENV=production
PORT=3000
PDF_FONT_PATH=/usr/share/fonts/google-noto-vf/NotoSansArabic[wght].ttf

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mr_electron

# Use a long random value in production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Comma-separated browser origins. Include every deployed frontend origin.
CLIENT_URL=https://mrelectron.example,https://student.mrelectron.example,https://admin.mrelectron.example,http://127.0.0.1:5174,http://localhost:5174

# Optional: only needed by legacy upload routes, not by the new curriculum/video flow.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bunny Stream (required only when Bunny is used for video storage/playback)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_PLAYER_HOST=iframe.mediadelivery.net
BUNNY_UPLOAD_EXPIRY_SECONDS=86400
BUNNY_PLAYBACK_EXPIRY_SECONDS=900
